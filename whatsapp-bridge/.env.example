# The bridge authenticates every REST route, /api/health included, with a bearer token.
# It generates one on first start and stores it in store/.bridge-token (mode 0600); the
# MCP server reads that file automatically. Override with WHATSAPP_BRIDGE_TOKEN (16+ chars).
# The old BRIDGE_API_TOKEN variable is no longer read.
# WHATSAPP_BRIDGE_TOKEN=
WEBHOOK_URL=
WHATSAPP_BRIDGE_PORT=8080
FORWARD_SELF=true
